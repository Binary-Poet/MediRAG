# ===== 应用 =====
APP_NAME=MediRAG
APP_ENV=dev
CORS_ORIGINS=["http://localhost:5173"]

# ===== 聊天模型（API 优先，DeepSeek 主力 / Qwen 备用，可切换）=====
LLM_VENDOR=deepseek
LLM_MODEL_MAIN=deepseek-chat
LLM_MODEL_ALT=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding / Rerank（SiliconFlow API 优先；有 GPU 可改 local）=====
EMBED_VENDOR=siliconflow
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_VENDOR=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 向量库（阶段 1：numpy 本地后端；Windows 不支持 milvus-lite，后续 Docker 接 Milvus standalone）=====
VECTOR_STORE=numpy_local
VECTOR_STORE_PATH=../data/vectorstore/index.json
MILVUS_URI=../data/milvus/medirag.db
MILVUS_COLLECTION=tcm_chunks

# ===== Neo4j（docker compose up 启动）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medirag123

# ===== MySQL（docker compose up 启动）=====
MYSQL_DSN=mysql+pymysql://medirag:medirag123@localhost:3307/medirag

# ===== 记忆/缓存（P1 再切 redis）=====
REDIS_MODE=memory
REDIS_URL=redis://localhost:6379/0
